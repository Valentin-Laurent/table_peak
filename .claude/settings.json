{
  "enabledPlugins": {
    "beads-superpowers@beads-superpowers-marketplace": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(pdm:*)",
      "Bash(rtk git:*)"
    ],
    "deny": [
      "Edit(./Makefile)"
    ]
  }
}
